# Build-time config. Copy to .env.dev / .env.staging / .env.prod (gitignored) and fill in.
# Read by Flutter via: flutter run -t lib/main_dev.dart --dart-define-from-file=.env.dev
# Everything here is compiled into the app binary — public values only (URLs, OAuth client ids), never secrets.

# Hoo.Api origin, without /api/v1. Android emulator: http://10.0.2.2:5131
HOO_API_URL=http://localhost:5131
# Public storefront origin (share links)
HOO_WEB_URL=http://localhost:3000
# true → in-app fake backend, no server needed (always off in prod)
HOO_MOCK=false

# Google Sign-In: "Web application" client id (same as backend Auth:GoogleClientIds) and the iOS client id
HOO_GOOGLE_SERVER_CLIENT_ID=
HOO_GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple service id
HOO_APPLE_SERVICE_ID=

# SHA-256 SPKI pins (base64), comma-separated. Empty → pinning off
HOO_CERT_PINS=
